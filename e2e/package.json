{
  "name": "sementelivre-e2e",
  "version": "1.0.0",
  "description": "Testes web de ponta a ponta (front-app e front-site) contra o backend real",
  "scripts": {
    "test": "playwright test",
    "test:app": "playwright test --project=front-app",
    "test:site": "playwright test --project=front-site",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps chromium",
    "typecheck": "tsc -p ."
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.19.43",
    "typescript": "^5.6.3"
  },
  "private": true
}
