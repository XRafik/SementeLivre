# SEMENTE LIVRE - MODELO DE VARIÁVEIS DE AMBIENTE (PRODUÇÃO)
#
# Instruções:
# 1. Copie este arquivo para backend/.env (que está no .gitignore)
# 2. Preencha os valores reais antes de subir a stack de produção

#Banco de Dados (PostgreSQL)
DB_USER=semente_user
DB_PASSWORD=coloque_uma_senha_forte_aqui_em_producao
DB_NAME=semente_prod

#Segurança e JWT
#Deve ser uma chave aleatória com mais de 32 caracteres (256 bits)
JWT_SECRET=coloque_aqui_uma_chave_secreta_com_mais_de_32_caracteres_em_producao
JWT_EXPIRATION=1800000

#CORS (Origens permitidas separadas por vírgula)
#Quando o instituto fornecer o IP ou domínio (ex: http://200.131.x.x:3000 ou https://semente.riopomba.ifsudestemg.edu.br):
CORS_ALLOWED_ORIGINS=

#Servidor/Domínio (Para Caddy / HTTPS)
DOMAIN_NAME=

#E-mail (SMTP)
# Sem MAIL_USERNAME e MAIL_PASSWORD o backend NÃO envia e-mails
# (cópia do pedido, recuperação de senha) — só registra no log.
# Gmail: MAIL_PASSWORD é uma "senha de app" (Conta Google > Segurança >
# Verificação em duas etapas > Senhas de app), não a senha normal da conta.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Remetente; vazio usa o MAIL_USERNAME
MAIL_FROM=
