# Copie para backend/.env (que está no .gitignore) e preencha.
# O docker compose lê este arquivo automaticamente.
#
# Sem MAIL_USERNAME e MAIL_PASSWORD o backend NÃO envia e-mails
# (cópia do pedido, recuperação de senha) — só registra no log.
#
# Gmail: MAIL_PASSWORD é uma "senha de app" (Conta Google > Segurança >
# Verificação em duas etapas > Senhas de app), não a senha normal da conta.

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Remetente; vazio usa o MAIL_USERNAME
MAIL_FROM=
